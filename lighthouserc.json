{
  "ci": {
    "collect": {
      "staticDistDir": "./_site",
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox"
      },
      "url": [
        "http://localhost/index.html",
        "http://localhost/projets/index.html",
        "http://localhost/projets/nox/index.html",
        "http://localhost/projets/continental-it/index.html",
        "http://localhost/projets/expoia/index.html"
      ]
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "warn",
          {
            "minScore": 0.9
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.95
          }
        ]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
